# Copie para .env e use a senha e a porta definidas no .env da raiz.
# Nesta task, DATABASE_URL e APP_TIMEZONE sao obrigatorias. Variaveis de
# autenticacao sera usada nas respectivas tasks. Nao ha envio de e-mail na V1.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://barbearia:SENHA_LOCAL@127.0.0.1:5432/barbearia_db?schema=public
JWT_SECRET=
JWT_EXPIRES_IN=
APP_TIMEZONE=America/Sao_Paulo
FRONTEND_URL=
CORS_ORIGINS=
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_SENHA=
