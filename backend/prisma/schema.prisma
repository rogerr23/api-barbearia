generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilUsuario {
  CLIENTE
  BARBEIRO
  ADMINISTRADOR
}

model Usuario {
  id                  Int                @id @default(autoincrement())
  email               String             @unique @db.VarChar(254)
  senhaHash           String
  perfil              PerfilUsuario
  ativo               Boolean            @default(true)
  primeiroAcesso      Boolean            @default(false)
  criadoEm            DateTime           @default(now()) @db.Timestamptz(6)
  atualizadoEm        DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  cliente             Cliente?
  barbeiro            Barbeiro?
  recuperacoesDeSenha RecuperacaoSenha[]
}

model Cliente {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @unique
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  nome         String
  telefone     String
  bairro       String
  criadoEm     DateTime @default(now()) @db.Timestamptz(6)
  atualizadoEm DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model Barbeiro {
  id                 Int      @id @default(autoincrement())
  usuarioId          Int      @unique
  usuario            Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  nome               String
  telefone           String
  comissaoPercentual Decimal  @default(50.00) @db.Decimal(5, 2)
  criadoEm           DateTime @default(now()) @db.Timestamptz(6)
  atualizadoEm       DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model RecuperacaoSenha {
  id          Int       @id @default(autoincrement())
  usuarioId   Int
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tokenHash   String    @unique
  expiraEm    DateTime  @db.Timestamptz(6)
  utilizadoEm DateTime? @db.Timestamptz(6)
  criadoEm    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([usuarioId])
}
